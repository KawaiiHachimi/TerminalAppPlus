[Unit]
Description=Terminal Plus localhost port proxy
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/terminal-plus-proxy.py
User=droid
Group=users
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_VSOCK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
