[Unit]
Description=Terminal Plus guest screen capture
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/terminal-plus-capture.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_VSOCK

[Install]
WantedBy=multi-user.target
